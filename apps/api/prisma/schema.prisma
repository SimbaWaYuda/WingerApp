generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum SyncEventStatus {
  SUCCESS
  CONFLICT
  DUPLICATE
}

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
}

enum OrderStatus {
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  PARTIAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnRequestStatus {
  REQUESTED
  IN_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

/// Manual refund tracking for Slice 5b (no automatic payment reversal yet).
enum ReturnRefundStatus {
  NONE
  PENDING
  ISSUED
  NOT_REQUIRED
}

/// Recognition lifecycle for line commissions (Slice 5a / 5b clawbacks).
enum CommissionRecognitionStatus {
  PENDING
  RECOGNIZED
  SETTLEABLE
  /// Refund issued — commission removed from settleable/pending totals.
  CLAWED_BACK
}

enum CommissionAgreementStatus {
  PROPOSED
  COUNTERED
  APPROVED
  ACTIVE
  REJECTED
  SUPERSEDED
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String
  name             String
  role             UserRole
  supplierId       String?
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  preferredLocale  String?
  /// ISO 4217 display preference. Null means show settlement currency.
  displayCurrency  String?
  phone            String?
  city             String?
  addressLine      String?
  profileComplete  Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  orders           Order[]
  onboarding       OnboardingProgress?
  supplierReviews  SupplierReview[]
  returnRequests   ReturnRequest[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  commissionAgreementsProposed SupplierCommissionAgreement[] @relation("AgreementProposedBy")
  commissionAgreementsApproved SupplierCommissionAgreement[] @relation("AgreementApprovedBy")
  commissionAgreementsAccepted SupplierCommissionAgreement[] @relation("AgreementAcceptedBy")

  @@index([role])
  @@index([supplierId])
}

model Supplier {
  id                   String           @id
  name                 String
  businessBio          String?
  verificationStatus   String           @default("UNVERIFIED")
  payoutSetupComplete  Boolean          @default(false)
  deliveryNotes        String?
  deliveryConfigured   Boolean          @default(false)
  ratingAvg            Float            @default(0)
  ratingCount          Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  products             Product[]
  users                User[]
  orderItems           OrderItem[]
  reviews              SupplierReview[]
  commissionAgreements SupplierCommissionAgreement[]
}

/// Customer rating of a supplier after a delivered shipment.
model SupplierReview {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([orderId, supplierId, customerId])
  @@index([supplierId, createdAt])
  @@index([customerId])
}

/// Per-user onboarding checklist progress (never grants roles).
model OnboardingProgress {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               UserRole
  completedKeys      Json      @default("[]")
  skippedKeys        Json      @default("[]")
  activityFlags      Json      @default("{}")
  checklistDismissed Boolean   @default(false)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Singleton platform ops flags for admin onboarding verification.
model PlatformSettings {
  id                        String   @id @default("default")
  /// Settlement / supplier / commission currency (ISO 4217).
  currency                  String   @default("USD")
  supportedDisplayCurrencies Json    @default("[\"USD\",\"TZS\",\"KES\",\"EUR\"]")
  /// Currencies the payment provider may charge. Subset of display list.
  supportedPaymentCurrencies Json    @default("[\"USD\",\"TZS\"]")
  /// Refuse FX quotes older than this many seconds.
  fxMaxAgeSeconds           Int      @default(86400)
  timezone                  String   @default("Africa/Nairobi")
  setupComplete             Boolean  @default(false)
  permissionsSeeded         Boolean  @default(false)
  deliveryConfigured        Boolean  @default(false)
  paymentsConfigured        Boolean  @default(false)
  commissionsConfigured     Boolean  @default(false)
  /// Default marketplace commission % (admin-configurable). Slice 5a default: 10.
  defaultCommissionPercent  Decimal  @default(10) @db.Decimal(5, 2)
  updatedAt                 DateTime @updatedAt
}

/// Supplier-specific commission rate agreement (proposal → approve → accept → active).
model SupplierCommissionAgreement {
  id                     String                    @id @default(cuid())
  supplierId             String
  supplier               Supplier                  @relation(fields: [supplierId], references: [id])
  proposedRatePercent    Decimal                   @db.Decimal(5, 2)
  counterRatePercent     Decimal?                  @db.Decimal(5, 2)
  effectiveRatePercent   Decimal?                  @db.Decimal(5, 2)
  status                 CommissionAgreementStatus @default(PROPOSED)
  proposedByRole         UserRole
  proposedByUserId       String
  proposedBy             User                      @relation("AgreementProposedBy", fields: [proposedByUserId], references: [id])
  approvedByUserId       String?
  approvedBy             User?                     @relation("AgreementApprovedBy", fields: [approvedByUserId], references: [id])
  acceptedByUserId       String?
  acceptedBy             User?                     @relation("AgreementAcceptedBy", fields: [acceptedByUserId], references: [id])
  effectiveFrom          DateTime?
  effectiveTo            DateTime?
  notes                  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  commissionSnapshots    OrderItemCommission[]

  @@index([supplierId, status])
  @@index([supplierId, effectiveFrom])
}

/// One unit of baseCurrency equals `rate` units of quoteCurrency.
model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(18, 8)
  source        String   @default("manual")
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency])
  @@index([expiresAt])
}

/// Append-only audit of commission rate / agreement changes.
model AuditLog {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  action       String
  actorUserId  String
  actor        User     @relation(fields: [actorUserId], references: [id])
  actorRole    UserRole
  beforeJson   Json?
  afterJson    Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model Product {
  id            String      @id
  name          String
  brand         String
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  supplierName  String
  price         Decimal     @db.Decimal(12, 2)
  /// Supplier selling currency. Display conversion never rewrites this.
  priceCurrency String      @default("USD")
  previousPrice Decimal?    @db.Decimal(12, 2)
  rating        Float       @default(4.5)
  imageUrl      String
  category      String
  model         String      @default("Standard")
  color         String      @default("Default")
  size          String      @default("Standard")
  battery       String      @default("—")
  weight        String      @default("—")
  /// Custom supplier specs: [{ "label": "Material", "value": "Cotton" }]
  extraSpecs    Json        @default("[]")
  description   String      @default("")
  stock         Int         @default(0)
  stockStatus   StockStatus @default(IN_STOCK)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  images          ProductImage[]
  inventoryLedger InventoryLedger[]
  orderItems      OrderItem[]

  @@index([supplierId])
  @@index([category])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Order {
  id                    String        @id @default(cuid())
  displayId             String        @unique
  customerId            String
  customer              User          @relation(fields: [customerId], references: [id])
  customerName          String
  customerEmail         String
  status                OrderStatus   @default(PROCESSING)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentMethod         String        @default("card")
  paymentMode           String        @default("demo")
  stripePaymentIntentId String?
  /// Legacy mirror of settlementCurrency (kept for existing clients).
  currency              String        @default("USD")
  settlementCurrency    String        @default("USD")
  displayCurrency       String?
  displaySubtotal       Decimal?      @db.Decimal(12, 2)
  displayTaxAmount      Decimal?      @db.Decimal(12, 2)
  displayDeliveryFee    Decimal?      @db.Decimal(12, 2)
  displayTotal          Decimal?      @db.Decimal(12, 2)
  paymentCurrency       String        @default("USD")
  paymentAmount         Decimal?      @db.Decimal(12, 2)
  /// Locked at checkout. Null on legacy orders — never recomputed.
  fxRate                Decimal?      @db.Decimal(18, 8)
  fxBaseCurrency        String?
  fxQuoteCurrency       String?
  fxFetchedAt           DateTime?
  fxExpiresAt           DateTime?
  fxSource              String?
  subtotal              Decimal       @db.Decimal(12, 2)
  /// Recorded separately from product subtotal; not part of commission base.
  taxAmount             Decimal       @default(0) @db.Decimal(12, 2)
  /// Recorded separately from product subtotal; not part of commission base.
  deliveryFee           Decimal       @default(0) @db.Decimal(12, 2)
  total                 Decimal       @db.Decimal(12, 2)
  addressLine           String?
  city                  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  items                 OrderItem[]
  supplierReviews       SupplierReview[]
  returnRequests        ReturnRequest[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  productName  String
  supplierId   String
  supplier     Supplier    @relation(fields: [supplierId], references: [id])
  supplierName String
  unitPrice    Decimal     @db.Decimal(12, 2)
  priceCurrency String     @default("USD")
  displayUnitPrice Decimal? @db.Decimal(12, 2)
  displayLineTotal Decimal? @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal     @db.Decimal(12, 2)
  status       OrderStatus @default(PROCESSING)
  trackingCode String?
  pickupCode   String?
  /// When set, this line is a no-charge replacement for a previously returned line.
  replacesOrderItemId String?    @unique
  replacesOrderItem   OrderItem? @relation("ItemReplacement", fields: [replacesOrderItemId], references: [id], onDelete: SetNull)
  replacedBy          OrderItem? @relation("ItemReplacement")
  returnRequests ReturnRequest[]
  commission   OrderItemCommission?

  @@index([orderId])
  @@index([supplierId])
  @@index([productId])
}

/// Immutable rate/base/amount snapshot per order line (status may advance).
model OrderItemCommission {
  id               String                      @id @default(cuid())
  orderItemId      String                      @unique
  orderItem        OrderItem                   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  agreementId      String?
  agreement        SupplierCommissionAgreement? @relation(fields: [agreementId], references: [id])
  ratePercent      Decimal                     @db.Decimal(5, 2)
  commissionBase   Decimal                     @db.Decimal(12, 2)
  commissionAmount Decimal                     @db.Decimal(12, 2)
  /// Settlement currency of the selling price. Not the customer display currency.
  currency         String                      @default("USD")
  status           CommissionRecognitionStatus @default(PENDING)
  paymentMode      String
  /// Demo charges are tracked but not treated as real financial settlement.
  isDemo           Boolean                     @default(false)
  recognizedAt     DateTime?
  settleableAt     DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([status])
  @@index([agreementId])
}

/// Customer return / support request after delivery (no auto-refund yet).
model ReturnRequest {
  id           String              @id @default(cuid())
  orderId      String
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerId   String
  customer     User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason       String
  notes        String?
  quantity     Int
  status       ReturnRequestStatus @default(REQUESTED)
  refundStatus ReturnRefundStatus  @default(NONE)
  refundNote   String?
  refundedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([orderId, createdAt])
  @@index([customerId])
  @@index([orderItemId])
  @@index([status])
  @@index([refundStatus])
}

/// In-app (and optional WhatsApp) customer notifications.
model Notification {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  title           String
  body            String
  entityType      String?
  entityId        String?
  readAt          DateTime?
  /// in_app | whatsapp_sent | whatsapp_noop | whatsapp_skipped | whatsapp_failed
  whatsappStatus  String?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Append-only ledger of inventory deltas (source of truth for stock math).
model InventoryLedger {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  supplierId  String
  delta       Int
  reason      String
  eventId     String   @unique
  deviceId    String?
  userId      String?
  quantityAfter Int
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([supplierId])
}

/// Server-side sync outbox/inbox for idempotent client events.
model SyncEvent {
  eventId     String          @id
  deviceId    String
  userId      String?
  businessId  String?
  operation   String
  payloadJson Json
  status      SyncEventStatus
  message     String?
  clientTs    DateTime?
  receivedAt  DateTime        @default(now())

  @@index([operation, receivedAt])
  @@index([deviceId])
}
