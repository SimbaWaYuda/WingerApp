generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum SyncEventStatus {
  SUCCESS
  CONFLICT
  DUPLICATE
}

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
}

enum OrderStatus {
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  PARTIAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnRequestStatus {
  REQUESTED
  IN_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

/// Manual refund tracking for Slice 5b (no automatic payment reversal yet).
enum ReturnRefundStatus {
  NONE
  PENDING
  ISSUED
  NOT_REQUIRED
}

/// Durable card refund attempt (Phase 3 RefundAttempt). COD/Lipa do not use this table.
enum RefundAttemptStatus {
  PENDING
  SUBMISSION_UNKNOWN
  STRIPE_SUCCEEDED
  STRIPE_FAILED
  APPLY_FAILED
  APPLIED
  NEEDS_INVESTIGATION
  PERMANENTLY_FAILED
  SUPERSEDED
}

enum RefundAttemptKind {
  RETURN
  ORDER_CANCEL
  LINE_CANCEL
  CANCEL_REMAINING
  UNSELLABLE
}

/// Parallel Connect transfer-reversal machine for a RefundAttempt.
enum TransferReversalStatus {
  NOT_REQUIRED
  PENDING
  SUCCEEDED
  FAILED_RETRYABLE
  SUBMISSION_UNKNOWN
  BLOCKED_LIVE
  OUTSTANDING
  SKIPPED_PARTIAL
  WRITTEN_OFF
}

enum RefundReconciliationResult {
  NONE
  MATCHED
  NO_MATCH
  AMBIGUOUS
  UNVERIFIED_LEGACY
}

/// One Stripe refunds.create attempt version under a RefundAttempt.
enum RefundSubmissionOutcome {
  PENDING
  SUBMISSION_UNKNOWN
  SUCCEEDED
  FAILED
  /// Prior version closed after reconcile NO_MATCH; a newer version row exists.
  SUPERSEDED_BY_NO_MATCH
}

/// Recognition lifecycle for line commissions (Slice 5a / 5b clawbacks).
enum CommissionRecognitionStatus {
  PENDING
  RECOGNIZED
  SETTLEABLE
  /// Refund issued — commission removed from settleable/pending totals.
  CLAWED_BACK
}

enum CommissionAgreementStatus {
  PROPOSED
  COUNTERED
  APPROVED
  ACTIVE
  REJECTED
  SUPERSEDED
}

enum CommissionRemittanceMethod {
  WINGER_LIPA
  BANK_TRANSFER
  ADMIN_RECORDED
}

enum CommissionRemittanceStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  REVERSED
}

enum CommissionEvidenceStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum CommissionAllocationReason {
  AUTO
  MANUAL
  SWEEP
}

/// Distinguishes a human user from Winger's own ledger worker.
/// System rows do not point at a User.
enum CommissionActorType {
  USER
  SYSTEM
}

enum CommissionRecognitionJobStatus {
  PENDING
  AWAITING_SWEEP
  COMPLETED
}

enum CommissionCreditReason {
  CLAWBACK_AFTER_COLLECTION
}

enum CommissionCreditApplicationReason {
  AUTO
  MANUAL
}

enum CommissionApplicationReversalReason {
  CUSTOMER_REFUND
  REMITTANCE_REVERSED
  MANUAL
}

/// Who should receive customer funds for this supplier's merchandise.
enum PaymentArrangementPreference {
  WINGER_MANAGED
  SUPPLIER_DIRECT
}

enum SupplierPaymentProfileStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  SUPERSEDED
}

enum MobileMoneyNetwork {
  ALL_NETWORKS
  M_PESA
  TIGO
  AIRTEL
  HALO
  OTHER
}

model User {
  id                           String                         @id @default(cuid())
  email                        String                         @unique
  passwordHash                 String
  name                         String
  role                         UserRole
  supplierId                   String?
  supplier                     Supplier?                      @relation(fields: [supplierId], references: [id])
  preferredLocale              String?
  /// ISO 4217 display preference. Null means show settlement currency.
  displayCurrency              String?
  phone                        String?
  city                         String?
  addressLine                  String?
  profileComplete              Boolean                        @default(false)
  /// Set when the person asks for a new password from the login screen.
  passwordResetRequestedAt     DateTime?
  /// Admin set a temporary password. Sign-in stays on the choose-password screen.
  mustChangePassword           Boolean                        @default(false)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  orders                       Order[]
  onboarding                   OnboardingProgress?
  supplierReviews              SupplierReview[]
  returnRequests               ReturnRequest[]
  notifications                Notification[]
  auditLogs                    AuditLog[]
  cashCollections              CashCollection[]
  commissionAgreementsProposed SupplierCommissionAgreement[]  @relation("AgreementProposedBy")
  commissionAgreementsApproved SupplierCommissionAgreement[]  @relation("AgreementApprovedBy")
  commissionAgreementsAccepted SupplierCommissionAgreement[]  @relation("AgreementAcceptedBy")
  paymentProfilesSubmitted     SupplierPaymentProfile[]       @relation("PaymentProfileSubmittedBy")
  paymentProfilesReviewed      SupplierPaymentProfile[]       @relation("PaymentProfileReviewedBy")
  remittancesSubmitted         CommissionRemittance[]         @relation("RemittanceSubmittedBy")
  remittancesReviewed          CommissionRemittance[]         @relation("RemittanceReviewedBy")
  remittancesReversed          CommissionRemittanceReversal[] @relation("RemittanceReversedBy")
  lipaEvidenceSubmitted        CustomerPaymentEvidence[]      @relation("LipaEvidenceSubmittedBy")
  lipaEvidenceReviewed         CustomerPaymentEvidence[]      @relation("LipaEvidenceReviewedBy")
  refundAttempts               RefundAttempt[]

  @@index([role])
  @@index([supplierId])
}

model Supplier {
  id                    String                        @id
  name                  String
  businessBio           String?
  verificationStatus    String                        @default("UNVERIFIED")
  payoutSetupComplete   Boolean                       @default(false)
  /// Stripe Connect account in test mode. Null until the supplier starts payout setup.
  stripeAccountId       String?                       @unique
  stripeConnectState    String?                       @unique
  stripePayoutsEnabled  Boolean                       @default(false)
  deliveryNotes         String?
  deliveryConfigured    Boolean                       @default(false)
  /// Customer delivery prices in settlement USD. 0 means that method is free.
  standardDeliveryFee   Decimal                       @default(4.99) @db.Decimal(12, 2)
  expressDeliveryFee    Decimal                       @default(9.99) @db.Decimal(12, 2)
  pickupDeliveryFee     Decimal                       @default(0) @db.Decimal(12, 2)
  /// When set, standard delivery is free once this supplier's items reach this USD amount.
  freeDeliveryThreshold Decimal?                      @db.Decimal(12, 2)
  /// Percent used when the delivery city and the product have no rate of their own. 0 means no tax.
  taxRatePercent        Decimal                       @default(8) @db.Decimal(5, 2)
  taxOnDelivery         Boolean                       @default(false)
  cityTaxes             SupplierCityTax[]
  /// Who carries a delivered order: the supplier, or a named courier. Pickup ignores this.
  carrier               String                        @default("supplier")
  courierName           String?
  /// Town used for customer distance search. Coordinates are optional.
  city                  String?
  latitude              Float?
  longitude             Float?
  ratingAvg             Float                         @default(0)
  ratingCount           Int                           @default(0)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  products              Product[]
  users                 User[]
  orderItems            OrderItem[]
  shipments             OrderShipment[]
  reviews               SupplierReview[]
  commissionAgreements  SupplierCommissionAgreement[]
  cashCollections       CashCollection[]
  paymentProfiles       SupplierPaymentProfile[]
  commissionRemittances CommissionRemittance[]
  commissionCredits     CommissionCredit[]
  lipaEvidence          CustomerPaymentEvidence[]
  refundAttempts        RefundAttempt[]
}

/// Versioned Lipa/Till registration. SUPPLIER_DIRECT is live only when status=APPROVED.
model SupplierPaymentProfile {
  id                String                       @id @default(cuid())
  supplierId        String
  supplier          Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  preference        PaymentArrangementPreference @default(WINGER_MANAGED)
  network           MobileMoneyNetwork           @default(ALL_NETWORKS)
  merchantName      String
  lipaOrTillNumber  String
  businessRegRef    String?
  tinRef            String?
  notes             String?
  status            SupplierPaymentProfileStatus @default(DRAFT)
  version           Int                          @default(1)
  submittedAt       DateTime?
  submittedByUserId String?
  submittedBy       User?                        @relation("PaymentProfileSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedAt        DateTime?
  reviewedByUserId  String?
  reviewedBy        User?                        @relation("PaymentProfileReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewNote        String?
  activeFrom        DateTime?
  /// Prior approved row this version replaces after admin approval.
  replacesProfileId String?                      @unique
  replacesProfile   SupplierPaymentProfile?      @relation("PaymentProfileVersion", fields: [replacesProfileId], references: [id])
  replacedBy        SupplierPaymentProfile?      @relation("PaymentProfileVersion")
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([supplierId, status])
  @@index([status, submittedAt])
}

/// Destination-city tax for one supplier. A product rate overrides this.
model SupplierCityTax {
  id             String   @id @default(cuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  /// Trimmed city name shown to the supplier.
  city           String
  /// Lowercase city used to match checkout. Unique per supplier.
  cityKey        String
  taxRatePercent Decimal  @db.Decimal(5, 2)

  @@unique([supplierId, cityKey])
  @@index([supplierId])
}

/// Customer rating of a supplier after a delivered shipment.
model SupplierReview {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([orderId, supplierId, customerId])
  @@index([supplierId, createdAt])
  @@index([customerId])
}

/// Per-user onboarding checklist progress (never grants roles).
model OnboardingProgress {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               UserRole
  completedKeys      Json      @default("[]")
  skippedKeys        Json      @default("[]")
  activityFlags      Json      @default("{}")
  checklistDismissed Boolean   @default(false)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Singleton platform ops flags for admin onboarding verification.
model PlatformSettings {
  id                         String   @id @default("default")
  /// Settlement / supplier / commission currency (ISO 4217).
  currency                   String   @default("USD")
  supportedDisplayCurrencies Json     @default("[\"USD\",\"TZS\",\"KES\",\"EUR\"]")
  /// Currencies the payment provider may charge. Subset of display list.
  supportedPaymentCurrencies Json     @default("[\"USD\",\"TZS\"]")
  /// Refuse FX quotes older than this many seconds.
  fxMaxAgeSeconds            Int      @default(86400)
  timezone                   String   @default("Africa/Nairobi")
  setupComplete              Boolean  @default(false)
  permissionsSeeded          Boolean  @default(false)
  deliveryConfigured         Boolean  @default(false)
  paymentsConfigured         Boolean  @default(false)
  commissionsConfigured      Boolean  @default(false)
  /// Default marketplace commission % (admin-configurable). Slice 5a default: 10.
  defaultCommissionPercent   Decimal  @default(10) @db.Decimal(5, 2)
  /// Winger receiving accounts for supplier commission remittances. Empty until an admin sets them.
  wingerLipaNumber           String   @default("")
  wingerLipaNetwork          String   @default("")
  wingerBankName             String   @default("")
  wingerBankAccountName      String   @default("")
  wingerBankAccountNumber    String   @default("")
  updatedAt                  DateTime @updatedAt
}

/// Supplier-specific commission rate agreement (proposal → approve → accept → active).
model SupplierCommissionAgreement {
  id                   String                    @id @default(cuid())
  supplierId           String
  supplier             Supplier                  @relation(fields: [supplierId], references: [id])
  proposedRatePercent  Decimal                   @db.Decimal(5, 2)
  counterRatePercent   Decimal?                  @db.Decimal(5, 2)
  effectiveRatePercent Decimal?                  @db.Decimal(5, 2)
  status               CommissionAgreementStatus @default(PROPOSED)
  proposedByRole       UserRole
  proposedByUserId     String
  proposedBy           User                      @relation("AgreementProposedBy", fields: [proposedByUserId], references: [id])
  approvedByUserId     String?
  approvedBy           User?                     @relation("AgreementApprovedBy", fields: [approvedByUserId], references: [id])
  acceptedByUserId     String?
  acceptedBy           User?                     @relation("AgreementAcceptedBy", fields: [acceptedByUserId], references: [id])
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  notes                String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  commissionSnapshots  OrderItemCommission[]

  @@index([supplierId, status])
  @@index([supplierId, effectiveFrom])
}

/// One unit of baseCurrency equals `rate` units of quoteCurrency.
model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(18, 8)
  source        String   @default("manual")
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency])
  @@index([expiresAt])
}

/// Append-only audit of commission rate / agreement changes.
model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  actorRole   UserRole
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model Product {
  id             String      @id
  name           String
  brand          String
  supplierId     String
  supplier       Supplier    @relation(fields: [supplierId], references: [id])
  supplierName   String
  price          Decimal     @db.Decimal(12, 2)
  /// Supplier selling currency. Display conversion never rewrites this.
  priceCurrency  String      @default("USD")
  previousPrice  Decimal?    @db.Decimal(12, 2)
  rating         Float       @default(4.5)
  imageUrl       String
  category       String
  model          String      @default("Standard")
  color          String      @default("Default")
  size           String      @default("Standard")
  battery        String      @default("—")
  weight         String      @default("—")
  /// Custom supplier specs: [{ "label": "Material", "value": "Cotton" }]
  extraSpecs     Json        @default("[]")
  description    String      @default("")
  /// Bilingual search bag. Displayed name and description stay on those columns.
  searchText     String      @default("") @db.Text
  /// Null uses the delivery-city rate, then the supplier rate. 0 means this product is tax free.
  taxRatePercent Decimal?    @db.Decimal(5, 2)
  stock          Int         @default(0)
  stockStatus    StockStatus @default(IN_STOCK)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  images          ProductImage[]
  variants        ProductVariant[]
  inventoryLedger InventoryLedger[]
  orderItems      OrderItem[]
  searchEmbedding ProductSearchEmbedding?

  @@index([supplierId])
  @@index([category])
  @@index([name])
}

/// Sellable size/colour (etc.) combination with its own stock.
/// Products with zero variants keep using Product.stock (legacy).
model ProductVariant {
  id              String            @id @default(cuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Empty string means this axis is not used for the product.
  color           String            @default("")
  size            String            @default("")
  /// Optional swatch hint (#RRGGBB). Clients may also map from color name.
  colorHex        String?
  sku             String?
  stock           Int               @default(0)
  stockStatus     StockStatus       @default(IN_STOCK)
  enabled         Boolean           @default(true)
  sortOrder       Int               @default(0)
  imageUrl        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  orderItems      OrderItem[]
  images          ProductImage[]
  inventoryLedger InventoryLedger[]

  @@unique([productId, color, size])
  @@index([productId, enabled])
}

model ProductSearchEmbedding {
  productId   String   @id
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  model       String
  vector      Json
  contentHash String
  updatedAt   DateTime @updatedAt
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// When set, this image belongs to a colour / variant gallery.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Colour key matching ProductVariant.color for gallery filtering without a variant id.
  colorKey  String?
  url       String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId, sortOrder])
  @@index([variantId])
  @@index([productId, colorKey])
}

model Order {
  id                     String                    @id @default(cuid())
  displayId              String                    @unique
  customerId             String
  customer               User                      @relation(fields: [customerId], references: [id])
  customerName           String
  customerEmail          String
  /// Phone captured at checkout so the supplier can reach the customer.
  customerPhone          String?
  status                 OrderStatus               @default(PROCESSING)
  paymentStatus          PaymentStatus             @default(PENDING)
  paymentMethod          String                    @default("card")
  paymentMode            String                    @default("demo")
  stripePaymentIntentId  String?                   @unique
  /// Same customer retry of one checkout. Null on orders placed before this existed.
  checkoutIdempotencyKey String?                   @unique
  /// Legacy mirror of settlementCurrency (kept for existing clients).
  currency               String                    @default("USD")
  settlementCurrency     String                    @default("USD")
  displayCurrency        String?
  displaySubtotal        Decimal?                  @db.Decimal(12, 2)
  displayTaxAmount       Decimal?                  @db.Decimal(12, 2)
  displayDeliveryFee     Decimal?                  @db.Decimal(12, 2)
  displayTotal           Decimal?                  @db.Decimal(12, 2)
  paymentCurrency        String                    @default("USD")
  paymentAmount          Decimal?                  @db.Decimal(12, 2)
  /// Locked at checkout. Null on legacy orders — never recomputed.
  fxRate                 Decimal?                  @db.Decimal(18, 8)
  fxBaseCurrency         String?
  fxQuoteCurrency        String?
  fxFetchedAt            DateTime?
  fxExpiresAt            DateTime?
  fxSource               String?
  subtotal               Decimal                   @db.Decimal(12, 2)
  /// Recorded separately from product subtotal; not part of commission base.
  taxAmount              Decimal                   @default(0) @db.Decimal(12, 2)
  /// Recorded separately from product subtotal; not part of commission base.
  deliveryFee            Decimal                   @default(0) @db.Decimal(12, 2)
  total                  Decimal                   @db.Decimal(12, 2)
  addressLine            String?
  city                   String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  items                  OrderItem[]
  shipments              OrderShipment[]
  supplierReviews        SupplierReview[]
  returnRequests         ReturnRequest[]
  cashCollections        CashCollection[]
  lipaEvidence           CustomerPaymentEvidence[]
  refundAttempts         RefundAttempt[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

/// Locked checkout buckets per supplier. Never recomputed from live fee settings.
model OrderShipment {
  id                 String          @id @default(cuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier        @relation(fields: [supplierId], references: [id])
  supplierName       String
  merchandise        Decimal         @db.Decimal(12, 2)
  deliveryFee        Decimal         @db.Decimal(12, 2)
  merchandiseTax     Decimal         @db.Decimal(12, 2)
  deliveryTax        Decimal         @db.Decimal(12, 2)
  paymentMerchandise Decimal         @db.Decimal(12, 2)
  paymentDelivery    Decimal         @db.Decimal(12, 2)
  paymentTax         Decimal         @db.Decimal(12, 2)
  /// Payment-currency amount already refunded from this bucket.
  refundedAmount     Decimal         @default(0) @db.Decimal(12, 2)
  createdAt          DateTime        @default(now())
  refundAttempts     RefundAttempt[]

  @@unique([orderId, supplierId])
  @@index([supplierId])
}

/// Cash a supplier confirmed they collected on a pay-on-delivery order.
/// One row per supplier per order. Settleable commission still waits for delivery.
model CashCollection {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id])
  collectedByUserId String
  collectedBy       User     @relation(fields: [collectedByUserId], references: [id])
  amount            Decimal  @db.Decimal(12, 2)
  currency          String
  lineIds           Json
  createdAt         DateTime @default(now())

  @@unique([orderId, supplierId])
  @@index([supplierId])
}

model OrderItem {
  id                  String               @id @default(cuid())
  orderId             String
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product              @relation(fields: [productId], references: [id])
  productName         String
  /// Snapshot of the product/variant image at checkout for order history.
  imageUrl            String?
  /// Snapshot of the selected variant at checkout. Null on legacy / non-variant lines.
  variantId           String?
  variant             ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantColor        String?
  variantSize         String?
  supplierId          String
  supplier            Supplier             @relation(fields: [supplierId], references: [id])
  supplierName        String
  unitPrice           Decimal              @db.Decimal(12, 2)
  priceCurrency       String               @default("USD")
  displayUnitPrice    Decimal?             @db.Decimal(12, 2)
  displayLineTotal    Decimal?             @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal              @db.Decimal(12, 2)
  status              OrderStatus          @default(PROCESSING)
  trackingCode        String?
  pickupCode          String?
  /// Locked at checkout. Null on pickup and on orders before carriers existed.
  carrier             String?
  courierName         String?
  /// When set, this line is a no-charge replacement for a previously returned line.
  replacesOrderItemId String?              @unique
  replacesOrderItem   OrderItem?           @relation("ItemReplacement", fields: [replacesOrderItemId], references: [id], onDelete: SetNull)
  replacedBy          OrderItem?           @relation("ItemReplacement")
  /// Units already accepted back. The line stays DELIVERED until this reaches quantity.
  returnedQuantity    Int                  @default(0)
  returnRequests      ReturnRequest[]
  commission          OrderItemCommission?
  courierBooking      CourierBooking?
  refundAttempts      RefundAttempt[]

  @@index([orderId])
  @@index([supplierId])
  @@index([productId])
  @@index([variantId])
}

/// One booking for a courier shipment. Created when the supplier marks it shipped.
model CourierBooking {
  id             String    @id @default(cuid())
  orderItemId    String    @unique
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  courierName    String
  reference      String    @unique
  /// booked or cancelled
  status         String    @default("booked")
  dropoffCity    String?
  dropoffAddress String?
  driverName     String?
  driverPhone    String?
  plateNumber    String?
  /// Courier fee shown to the customer. It does not change the order total.
  fee            Decimal?  @db.Decimal(12, 2)
  trackingUrl    String?
  bookedAt       DateTime  @default(now())

  @@index([status])
}

/// Immutable rate/base/amount snapshot per order line (status may advance).
model OrderItemCommission {
  id                 String                        @id @default(cuid())
  orderItemId        String                        @unique
  orderItem          OrderItem                     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  agreementId        String?
  agreement          SupplierCommissionAgreement?  @relation(fields: [agreementId], references: [id])
  ratePercent        Decimal                       @db.Decimal(5, 2)
  commissionBase     Decimal                       @db.Decimal(12, 2)
  commissionAmount   Decimal                       @db.Decimal(12, 2)
  /// Settlement currency of the selling price. Not the customer display currency.
  currency           String                        @default("USD")
  status             CommissionRecognitionStatus   @default(PENDING)
  paymentMode        String
  /// Demo charges are tracked but not treated as real financial settlement.
  isDemo             Boolean                       @default(false)
  recognizedAt       DateTime?
  settleableAt       DateTime?
  /// Test-mode transfer of item total minus commission. Tax and delivery are not included.
  stripeTransferId   String?                       @unique
  transferAmount     Decimal?                      @db.Decimal(12, 2)
  transferCurrency   String?
  transferReversed   Boolean                       @default(false)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  cashAllocations    CommissionAllocation[]
  creditApplications CommissionCreditApplication[]
  clawbackCredits    CommissionCredit[]
  clawbacks          CommissionClawback[]

  @@index([status])
  @@index([agreementId])
}

/// Customer return after delivery. Marking a card refund ISSUED refunds that Stripe charge.
model ReturnRequest {
  id                 String              @id @default(cuid())
  orderId            String
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId        String
  orderItem          OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason             String
  notes              String?
  quantity           Int
  status             ReturnRequestStatus @default(REQUESTED)
  refundStatus       ReturnRefundStatus  @default(NONE)
  refundNote         String?
  refundedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  commissionClawback CommissionClawback?
  refundAttempts     RefundAttempt[]

  @@index([orderId, createdAt])
  @@index([customerId])
  @@index([orderItemId])
  @@index([status])
  @@index([refundStatus])
}

/// Durable Stripe card refund + Connect reverse bookkeeping (Phase 3).
/// Empty until Stage 2+ wires services. Existing returns/cancels are unchanged.
///
/// Idempotency / submission policy (enforced in Stage 2+ services):
/// - operationKey = one logical refund operation (stable, globally unique).
/// - Each Stripe submit version is an immutable RefundAttemptSubmission row.
/// - Retry the same submission with the same stripeIdempotencyKey (no new row).
/// - SUBMISSION_UNKNOWN must be reconciled before inserting a new version.
/// - New version INSERT only after previous version reconciliationResult = NO_MATCH
///   (never because of a timeout). Mark prior row SUPERSEDED_BY_NO_MATCH; do not overwrite it.
/// - Concurrency: Stage 2 locks the RefundAttempt row (SELECT … FOR UPDATE), reads
///   MAX(version), then INSERTs version+1. UNIQUE(refundAttemptId, version) and
///   UNIQUE(stripeIdempotencyKey) reject racing duplicate inserts.
model RefundAttempt {
  id              String              @id @default(cuid())
  /// Stable logical refund operation id (e.g. return:{id}). Globally unique; never versioned.
  operationKey    String              @unique
  kind            RefundAttemptKind
  status          RefundAttemptStatus @default(PENDING)
  orderId         String
  /// Restrict: hard-deleting an order must not erase refund / Connect financial history.
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequestId String?
  returnRequest   ReturnRequest?      @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  orderItemId     String?
  orderItem       OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  orderShipmentId String?
  orderShipment   OrderShipment?      @relation(fields: [orderShipmentId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  actorUserId     String
  actor           User                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  stripePaymentIntentId String
  /// Denormalized successful refund id (mirrors SUCCEEDED submission). Unique when set.
  stripeRefundId        String? @unique
  amount                Decimal @db.Decimal(12, 2)
  amountCents           Int
  currency              String
  /// Frozen bucket flag used when the refund amount was planned.
  includeDelivery       Boolean @default(false)

  shipmentRefundApplied Boolean   @default(false)
  clawbackAppliedAt     DateTime?
  appliedAt             DateTime?
  applyError            String?

  transferReversalStatus         TransferReversalStatus @default(NOT_REQUIRED)
  transferId                     String?
  transferReversalId             String?
  transferReversalIdempotencyKey String?
  transferSubmittedAt            DateTime?

  /// B1: proportional Connect transfer exposure (not commission).
  originalTransferAmount   Decimal? @db.Decimal(12, 2)
  originalMerchandiseBasis Decimal? @db.Decimal(12, 2)
  returnedMerchandise      Decimal? @db.Decimal(12, 2)
  reversedAmount           Decimal  @default(0) @db.Decimal(12, 2)
  unrecoveredAmount        Decimal  @default(0) @db.Decimal(12, 2)
  unrecoveredCurrency      String?
  unrecoveredCalcJson      Json?

  /// AuditLog.id references (string ids; written when override/write-off occurs).
  connectOverrideAuditId String?
  writeOffAuditId        String?
  writeOffAt             DateTime?
  investigationReason    String?
  lastError              String?

  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  submissions RefundAttemptSubmission[]

  @@index([orderId])
  @@index([returnRequestId])
  @@index([orderItemId])
  @@index([orderShipmentId])
  @@index([supplierId])
  @@index([actorUserId])
  @@index([status, updatedAt])
  @@index([transferReversalStatus, updatedAt])
  @@index([stripePaymentIntentId])
}

/// One Stripe refunds.create submission version for a RefundAttempt.
/// Rows are append-only for history: NO_MATCH opens a new version; prior rows stay.
model RefundAttemptSubmission {
  id                   String                     @id @default(cuid())
  refundAttemptId      String
  /// Restrict: keep submission history if an attempt row is targeted for delete.
  refundAttempt        RefundAttempt              @relation(fields: [refundAttemptId], references: [id], onDelete: Restrict)
  /// Monotonic per attempt; UNIQUE(refundAttemptId, version) blocks concurrent next-version races.
  version              Int
  /// Globally unique Stripe Idempotency-Key for this version only.
  stripeIdempotencyKey String                     @unique
  submittedAt          DateTime?
  reconciliationResult RefundReconciliationResult @default(NONE)
  /// Set when this submission's Stripe refund is known. Unique when set (one row per refund id).
  stripeRefundId       String?                    @unique
  outcome              RefundSubmissionOutcome    @default(PENDING)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([refundAttemptId, version])
  @@index([refundAttemptId])
  @@index([outcome, updatedAt])
}

/// Append-only slice of an original commission snapshot. The snapshot amounts are not rewritten.
model CommissionClawback {
  id                    String              @id @default(cuid())
  orderItemCommissionId String
  orderItemCommission   OrderItemCommission @relation(fields: [orderItemCommissionId], references: [id])
  returnRequestId       String              @unique
  returnRequest         ReturnRequest       @relation(fields: [returnRequestId], references: [id])
  quantity              Int
  merchandiseAmount     Decimal             @db.Decimal(12, 2)
  commissionAmount      Decimal             @db.Decimal(12, 2)
  /// Null until the refund is issued and the credit or allocation rows are written.
  appliedAt             DateTime?
  createdAt             DateTime            @default(now())

  @@index([orderItemCommissionId])
}

/// In-app (and optional WhatsApp) customer notifications.
model Notification {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  body           String
  entityType     String?
  entityId       String?
  readAt         DateTime?
  /// in_app | whatsapp_sent | whatsapp_noop | whatsapp_skipped | whatsapp_failed
  whatsappStatus String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Append-only ledger of inventory deltas (source of truth for stock math).
model InventoryLedger {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  supplierId    String
  delta         Int
  reason        String
  eventId       String          @unique
  deviceId      String?
  userId        String?
  quantityAfter Int
  createdAt     DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([supplierId])
}

/// Server-side sync outbox/inbox for idempotent client events.
model SyncEvent {
  eventId     String          @id
  deviceId    String
  userId      String?
  businessId  String?
  operation   String
  payloadJson Json
  status      SyncEventStatus
  message     String?
  clientTs    DateTime?
  receivedAt  DateTime        @default(now())

  @@index([operation, receivedAt])
  @@index([deviceId])
}

/// Supplier payment of commission to Winger. Verified money fields are written once.
model CommissionRemittance {
  id                  String                        @id @default(cuid())
  supplierId          String
  supplier            Supplier                      @relation(fields: [supplierId], references: [id])
  method              CommissionRemittanceMethod
  status              CommissionRemittanceStatus    @default(SUBMITTED)
  claimedAmount       Decimal                       @db.Decimal(12, 2)
  claimedCurrency     String
  verifiedAmountUsd   Decimal?                      @db.Decimal(12, 2)
  fxBaseCurrency      String?
  fxQuoteCurrency     String?
  fxRate              Decimal?                      @db.Decimal(18, 8)
  fxSource            String?
  fxFetchedAt         DateTime?
  fxExpiresAt         DateTime?
  referenceRaw        String
  referenceNormalized String
  provider            String
  merchantAccountKey  String
  proofStorageKey     String?
  autoApply           Boolean                       @default(true)
  supplierNote        String?
  reviewNote          String?
  submittedByUserId   String
  submittedBy         User                          @relation("RemittanceSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedByUserId    String?
  reviewedBy          User?                         @relation("RemittanceReviewedBy", fields: [reviewedByUserId], references: [id])
  verifiedAt          DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  paymentReference    CommissionPaymentReference?
  allocations         CommissionAllocation[]
  reversal            CommissionRemittanceReversal?

  @@index([supplierId, status])
  @@index([status, createdAt])
}

/// Non-null unique key. Rejected submissions delete this row. Verified and reversed rows stay.
model CommissionPaymentReference {
  id                  String                     @id @default(cuid())
  remittanceId        String                     @unique
  remittance          CommissionRemittance       @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  method              CommissionRemittanceMethod
  provider            String
  merchantAccountKey  String
  currency            String
  referenceNormalized String
  createdAt           DateTime                   @default(now())

  @@unique([method, provider, merchantAccountKey, currency, referenceNormalized])
}

/// One apply of a remittance to a snapshot. Later applies insert new rows.
model CommissionAllocation {
  id                    String                         @id @default(cuid())
  remittanceId          String
  remittance            CommissionRemittance           @relation(fields: [remittanceId], references: [id])
  orderItemCommissionId String
  orderItemCommission   OrderItemCommission            @relation(fields: [orderItemCommissionId], references: [id])
  amountUsd             Decimal                        @db.Decimal(12, 2)
  reason                CommissionAllocationReason
  actorUserId           String
  actorType             CommissionActorType            @default(USER)
  /// Set when actorType is SYSTEM. Null for a human administrator or supplier.
  systemActorKey        String?
  createdAt             DateTime                       @default(now())
  reversals             CommissionAllocationReversal[]
  creditSources         CommissionCreditSource[]

  @@index([remittanceId])
  @@index([orderItemCommissionId])
}

model CommissionAllocationReversal {
  id                   String                        @id @default(cuid())
  allocationId         String
  allocation           CommissionAllocation          @relation(fields: [allocationId], references: [id])
  remittanceReversalId String?
  remittanceReversal   CommissionRemittanceReversal? @relation(fields: [remittanceReversalId], references: [id])
  amountUsd            Decimal                       @db.Decimal(12, 2)
  reason               String
  reversalKey          String                        @unique
  actorUserId          String
  createdAt            DateTime                      @default(now())

  @@index([allocationId])
}

model CommissionRemittanceReversal {
  id                  String                         @id @default(cuid())
  remittanceId        String                         @unique
  remittance          CommissionRemittance           @relation(fields: [remittanceId], references: [id])
  amountUsd           Decimal                        @db.Decimal(12, 2)
  reason              String
  originalReference   String
  actorUserId         String
  actor               User                           @relation("RemittanceReversedBy", fields: [actorUserId], references: [id])
  createdAt           DateTime                       @default(now())
  allocationReversals CommissionAllocationReversal[]
  creditOffsets       CommissionCreditOffset[]
  providerEvent       CommissionProviderEvent?

  @@index([createdAt])
}

/// Present only when a provider sends an event id. eventId is never null.
model CommissionProviderEvent {
  id                   String                        @id @default(cuid())
  eventId              String                        @unique
  remittanceReversalId String?                       @unique
  remittanceReversal   CommissionRemittanceReversal? @relation(fields: [remittanceReversalId], references: [id])
  createdAt            DateTime                      @default(now())
}

model CommissionCredit {
  id                    String                        @id @default(cuid())
  supplierId            String
  supplier              Supplier                      @relation(fields: [supplierId], references: [id])
  orderItemCommissionId String
  orderItemCommission   OrderItemCommission           @relation(fields: [orderItemCommissionId], references: [id])
  amountUsd             Decimal                       @db.Decimal(12, 2)
  reason                CommissionCreditReason
  sourceEventKey        String                        @unique
  actorUserId           String
  createdAt             DateTime                      @default(now())
  sources               CommissionCreditSource[]
  applications          CommissionCreditApplication[]
  offsets               CommissionCreditOffset[]

  @@index([supplierId])
  @@index([orderItemCommissionId])
}

model CommissionCreditSource {
  id                 String                              @id @default(cuid())
  creditId           String
  credit             CommissionCredit                    @relation(fields: [creditId], references: [id])
  allocationId       String
  allocation         CommissionAllocation                @relation(fields: [allocationId], references: [id])
  amountUsd          Decimal                             @db.Decimal(12, 2)
  createdAt          DateTime                            @default(now())
  applicationSources CommissionCreditApplicationSource[]
  offsetSources      CommissionCreditOffsetSource[]

  @@index([creditId, createdAt])
  @@index([allocationId])
}

model CommissionCreditApplication {
  id                    String                              @id @default(cuid())
  creditId              String
  credit                CommissionCredit                    @relation(fields: [creditId], references: [id])
  orderItemCommissionId String
  orderItemCommission   OrderItemCommission                 @relation(fields: [orderItemCommissionId], references: [id])
  amountUsd             Decimal                             @db.Decimal(12, 2)
  reason                CommissionCreditApplicationReason
  actorUserId           String
  actorType             CommissionActorType                 @default(USER)
  systemActorKey        String?
  createdAt             DateTime                            @default(now())
  sources               CommissionCreditApplicationSource[]

  @@index([creditId])
  @@index([orderItemCommissionId])
}

model CommissionCreditApplicationSource {
  id             String                                      @id @default(cuid())
  applicationId  String
  application    CommissionCreditApplication                 @relation(fields: [applicationId], references: [id])
  creditSourceId String
  creditSource   CommissionCreditSource                      @relation(fields: [creditSourceId], references: [id])
  amountUsd      Decimal                                     @db.Decimal(12, 2)
  createdAt      DateTime                                    @default(now())
  reversals      CommissionCreditApplicationSourceReversal[]

  @@unique([applicationId, creditSourceId])
  @@index([creditSourceId])
}

model CommissionCreditApplicationSourceReversal {
  id                   String                              @id @default(cuid())
  applicationSourceId  String
  applicationSource    CommissionCreditApplicationSource   @relation(fields: [applicationSourceId], references: [id])
  amountUsd            Decimal                             @db.Decimal(12, 2)
  reason               CommissionApplicationReversalReason
  reversalKey          String                              @unique
  remittanceReversalId String?
  actorUserId          String
  createdAt            DateTime                            @default(now())

  @@index([applicationSourceId])
}

model CommissionCreditOffset {
  id                   String                         @id @default(cuid())
  creditId             String
  credit               CommissionCredit               @relation(fields: [creditId], references: [id])
  amountUsd            Decimal                        @db.Decimal(12, 2)
  reason               String
  remittanceReversalId String?
  remittanceReversal   CommissionRemittanceReversal?  @relation(fields: [remittanceReversalId], references: [id])
  actorUserId          String
  createdAt            DateTime                       @default(now())
  sources              CommissionCreditOffsetSource[]

  @@index([creditId])
  @@index([remittanceReversalId])
}

model CommissionCreditOffsetSource {
  id             String                 @id @default(cuid())
  offsetId       String
  offset         CommissionCreditOffset @relation(fields: [offsetId], references: [id])
  creditSourceId String
  creditSource   CommissionCreditSource @relation(fields: [creditSourceId], references: [id])
  amountUsd      Decimal                @db.Decimal(12, 2)

  @@unique([offsetId, creditSourceId])
  @@index([creditSourceId])
}

/// Customer paid the supplier's own Lipa number. This is not a commission remittance.
model CustomerPaymentEvidence {
  id                  String                       @id @default(cuid())
  orderId             String
  order               Order                        @relation(fields: [orderId], references: [id])
  supplierId          String
  supplier            Supplier                     @relation(fields: [supplierId], references: [id])
  referenceRaw        String
  referenceNormalized String
  proofStorageKey     String?
  note                String?
  status              CommissionEvidenceStatus     @default(SUBMITTED)
  submittedByUserId   String
  submittedBy         User                         @relation("LipaEvidenceSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedByUserId    String?
  reviewedBy          User?                        @relation("LipaEvidenceReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  openClaim           CustomerPaymentEvidenceOpen?

  @@index([supplierId, status])
  @@index([orderId])
}

/// One open Lipa claim per order and supplier. Deleted when the claim is verified or rejected.
model CustomerPaymentEvidenceOpen {
  orderId    String
  supplierId String
  evidenceId String                  @unique
  evidence   CustomerPaymentEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([orderId, supplierId])
}

/// Written in the same transaction that marks a Lipa order paid.
/// A crash after payment can resume recognition without verifying the evidence again.
model CommissionRecognitionJob {
  id          String                         @id @default(cuid())
  orderId     String
  orderItemId String                         @unique
  supplierId  String
  status      CommissionRecognitionJobStatus @default(PENDING)
  createdAt   DateTime                       @default(now())
  completedAt DateTime?

  @@index([orderId, status])
  @@index([status, createdAt])
}

/// Sweep and other system ledger actions. This table has no User foreign key.
model CommissionSystemEvent {
  id             String              @id @default(cuid())
  actorType      CommissionActorType @default(SYSTEM)
  systemActorKey String
  entityType     String
  entityId       String
  action         String
  supplierId     String?
  afterJson      Json?
  createdAt      DateTime            @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([supplierId, createdAt])
}
