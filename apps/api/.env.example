DATABASE_URL="postgresql://winger:winger@localhost:5433/winger?schema=public"
PORT=3000
PG_PORT=5433
JWT_SECRET="winger-dev-secret-change-me"

# Optional. Without this key, checkout uses demo payment (marks orders PAID).
# With a Stripe test secret key, checkout creates + confirms a PaymentIntent (pm_card_visa).
STRIPE_SECRET_KEY=""

# Optional. Without this token, Mixpanel events are logged as no-ops (no PII).
MIXPANEL_TOKEN=""

# Optional Twilio WhatsApp. Without these, return/refund notifies stay in-app
# and WhatsApp is logged as [whatsapp:noop] (customer needs a phone on profile).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Product images: local (default) or s3 (MinIO / R2 / AWS).
# scripts/dev.ps1 sets UPLOAD_DIR to %USERPROFILE%\WingerData\uploads when unset.
STORAGE_DRIVER=local
UPLOAD_DIR=
# Local MinIO smoke (docker compose -f docker-compose.minio.yml up -d):
#   .\scripts\minio-smoke.ps1
# STORAGE_DRIVER=s3
# S3_BUCKET=winger-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/winger-uploads
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=winger
# AWS_SECRET_ACCESS_KEY=wingersecret

