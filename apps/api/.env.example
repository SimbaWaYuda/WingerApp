DATABASE_URL="postgresql://winger:winger@localhost:5433/winger?schema=public"
PORT=3000
PG_PORT=5433
JWT_SECRET="winger-dev-secret-change-me"

# Optional. Without the secret key, card checkout is a demo charge (marks orders PAID).
# A test secret key (sk_test_) creates and confirms a PaymentIntent. Never commit the secret.
STRIPE_SECRET_KEY=""
# Publishable key (pk_test_ or pk_live_). Safe to expose to the app. Not enough to charge.
STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret from the Stripe dashboard (whsec_...). Required to accept
# payment_intent events. Leave empty until the endpoint is created. Never commit it.
# Endpoint: POST /stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=""
# Public https origin of this API, with no trailing slash. Stripe webhook and
# Connect return links use it. Leave empty on this computer; localhost is used.
# PUBLIC_API_ORIGIN=https://example.trycloudflare.com

# Optional live exchange-rate feed. Stale rates refresh from this URL.
# A rate an admin just saved stays until its lifetime ends.
# FX_FEED_URL=https://open.er-api.com/v6/latest

# Optional. Without this token, Mixpanel events are logged as no-ops (no PII).
MIXPANEL_TOKEN=""

# Optional product-search understanding. Empty keeps keyword browse.
# Never put this key in the Flutter app.
# SEARCH_AI_API_KEY=
# SEARCH_AI_BASE_URL=https://api.openai.com/v1
# SEARCH_AI_MODEL=gpt-4o-mini

# Optional Twilio WhatsApp. Without these, return/refund notifies stay in-app
# and WhatsApp is logged as [whatsapp:noop] (customer needs a phone on profile).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Product images: local (default) or s3 (MinIO / R2 / AWS).
# scripts/dev.ps1 sets UPLOAD_DIR to %USERPROFILE%\WingerData\uploads when unset.
STORAGE_DRIVER=local
UPLOAD_DIR=
# Local MinIO smoke (docker compose -f docker-compose.minio.yml up -d):
#   .\scripts\minio-smoke.ps1
# STORAGE_DRIVER=s3
# S3_BUCKET=winger-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/winger-uploads
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=winger
# AWS_SECRET_ACCESS_KEY=wingersecret

