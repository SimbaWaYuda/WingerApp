# --- Development (default on this computer) ---
# Strict production checks run only when NODE_ENV=production.
DATABASE_URL="postgresql://winger:winger@localhost:5433/winger?schema=public&options=-c%20client_encoding%3DUTF8"
PORT=3000
PG_PORT=5433
JWT_SECRET="winger-dev-secret-change-me"

# Optional. Without the secret key, card checkout is a demo charge (marks orders PAID).
# A test secret key (sk_test_) creates and confirms a PaymentIntent. Never commit the secret.
STRIPE_SECRET_KEY=""
# Publishable key (pk_test_ or pk_live_). Exposed to clients via the API; not used to charge.
# Not required by production env validation (Flutter/card UI may supply pk_ separately).
STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret from the Stripe dashboard (whsec_...). Required to accept
# payment_intent events. Leave empty until the endpoint is created. Never commit it.
# Endpoint: POST /stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=""
# Public https origin of this API, with no trailing slash. Stripe webhook and
# Connect return links use it. Leave empty on this computer; localhost is used.
# PUBLIC_API_ORIGIN=https://example.trycloudflare.com

# Payment reconcile worker. Leave UNSET until separately authorised.
# Do not set PAYMENT_RECONCILE_WORKER_ENABLED=1 in production examples or deploy env.
# PAYMENT_RECONCILE_WORKER_ENABLED=

# --- Production (NODE_ENV=production) ---
# Required: DATABASE_URL, JWT_SECRET (non-placeholder, >= 32 chars).
# Stripe: omit STRIPE_SECRET_KEY to run without card charges, OR set a full trio:
#   STRIPE_SECRET_KEY (sk_test_ / sk_live_), STRIPE_WEBHOOK_SECRET (whsec_...),
#   PUBLIC_API_ORIGIN (https://api.example.com — no trailing slash).
# Incomplete Stripe (secret without webhook) is rejected so demo checkout cannot
# silently replace production card payments.
# Without Stripe in production, COD/Lipa still work; card attempts are rejected
# (never demo-paid). Local non-production keeps demo card checkout.
# Storage: STORAGE_DRIVER=local (default) or s3. For s3 / Cloudflare R2 also set:
#   S3_BUCKET, S3_PUBLIC_BASE_URL, S3_ENDPOINT, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   Optional: S3_REGION=auto, S3_FORCE_PATH_STYLE=true

# Optional live exchange-rate feed. Stale rates refresh from this URL.
# A rate an admin just saved stays until its lifetime ends.
# FX_FEED_URL=https://open.er-api.com/v6/latest

# Optional. Without this token, Mixpanel events are logged as no-ops (no PII).
MIXPANEL_TOKEN=""

# Optional product-search understanding. Empty keeps keyword browse.
# Never put this key in the Flutter app.
# SEARCH_AI_API_KEY=
# SEARCH_AI_BASE_URL=https://api.openai.com/v1
# SEARCH_AI_MODEL=gpt-4o-mini
# SEARCH_EMBED_MODEL=text-embedding-3-small

# Optional Twilio WhatsApp. Without these, return/refund notifies stay in-app
# and WhatsApp is logged as [whatsapp:noop] (customer needs a phone on profile).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Product images: local (default) or s3 (MinIO / R2 / AWS).
# scripts/dev.ps1 sets UPLOAD_DIR to %USERPROFILE%\WingerData\uploads when unset.
STORAGE_DRIVER=local
UPLOAD_DIR=
# Local MinIO smoke (docker compose -f docker-compose.minio.yml up -d):
#   .\scripts\minio-smoke.ps1
# STORAGE_DRIVER=s3
# S3_BUCKET=winger-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/winger-uploads
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=winger
# AWS_SECRET_ACCESS_KEY=wingersecret

